# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.gdip text eol=lf
*.svg text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.mm text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.jar binary
