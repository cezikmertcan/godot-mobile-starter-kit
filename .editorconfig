root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.gd]
indent_style = tab

[*.{json,md,svg,yml,yaml}]
indent_style = space
indent_size = 2

[*.{cpp,h,java,kt,kts,mm,py}]
indent_style = space
indent_size = 4

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4
